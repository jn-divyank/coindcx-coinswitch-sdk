# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- CoinDCX ---
# Create at https://coindcx.com/api-dashboard
# Supports IP binding and read-only keys: use a READ-ONLY key unless you are placing orders.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# --- CoinSwitch ---
# Create in CoinSwitch PRO > Profile > API keys.
# WARNING: CoinSwitch allows ONE active key pair at a time, with no permission
# scoping and no IP allowlist. Any key here is a full-trade production key.
COINSWITCH_API_KEY=
COINSWITCH_API_SECRET=

# --- Safety ---
# Order placement is blocked unless BOTH the client is constructed with
# allow_live=True AND this is set to "1". Belt and braces, on purpose.
DCX_ALLOW_LIVE_TRADING=0
# Hard ceiling on the notional value of any single order, in quote currency.
DCX_MAX_NOTIONAL=0
